[sub_resource type="GDScript" id="GDScript_1lf08"]
resource_name = "Cantrip"
script/source = "extends CharacterBody2D


var SPEED = 300.0
@export var JUMP_VELOCITY = -400.0
var isJump
var isFall
var isJmpCD


func _ready() -> void:
	#$CollisionShape2D.debug_color = Color.BLUE
	isJump = false
	isFall = false
	isJmpCD = false
	pass # Replace with function body.




func _physics_process(delta: float) -> void:
	velocity = Vector2.ZERO # The player's movement vector.
	if Input.is_action_pressed(\"ui_right\"):
		velocity.x += 1
	if Input.is_action_pressed(\"ui_left\"):
		velocity.x -= 1
	if Input.is_action_pressed(\"ui_down\"):
		velocity.y += 1
	if Input.is_action_pressed(\"ui_up\") and not isJmpCD and not isJump and not isFall:
		velocity.y -= 1
		
	
	if Input.is_action_just_pressed(\"ui_accept\") and not isJump and not isJmpCD and not isFall:
		jump()
	
	if isJump:
		rotation += 30.0 * delta
		velocity.y -= 5.0	
	
	if isFall:
		rotation += 20.0 * delta
		velocity.y += 5.0	


	if velocity.length() > 0:
		velocity = velocity.normalized() * SPEED
		
	
	

	

	move_and_slide()

func jump():
	isJump = true
	#$CollisionShape2D.debug_color = Color.RED
	await get_tree().create_timer(0.25).timeout
	#$CollisionShape2D.debug_color = Color.DARK_RED
	isJump = false
	isFall = true
	await get_tree().create_timer(0.25).timeout
	isFall = false
	rotation = 0.0
	isJmpCD = true
	#$CollisionShape2D.debug_color = Color.GRAY
	await get_tree().create_timer(0.25).timeout
	isJmpCD = false
	#$CollisionShape2D.debug_color = Color.BLUE
	
	
	
	
	
	
	


	
	
	
"

