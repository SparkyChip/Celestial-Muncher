[sub_resource type="GDScript" id="GDScript_iwv7r"]
resource_name = "WORLD_SCRIPT_TEST"
script/source = "extends Node2D

@onready var path = \"res://Music/combat.mp3\"

var numSpells
const MAX_SPELLS = 5

const TRACKER_RANGE = 83

@onready var player = $C_PlayerBody

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	numSpells = 0
	$CursorTracker.global_position = $C_PlayerBody.global_position
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	if ($CursorTracker.global_position.distance_to($C_PlayerBody.global_position) > TRACKER_RANGE):
		$CursorTracker.global_position = $C_PlayerBody.global_position

# Called when the node enters the scene tree for the first time.
@onready var spell_path_01 = preload(\"res://Characters/Cantrip/Spells/magic_bomb.tscn\")
@onready var spell_path_02 = preload(\"res://Characters/Cantrip/Spells/MagicMissile.tscn\")

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _input(event):
	if event is InputEventMouseButton:
		if event.button_index == MouseButton.MOUSE_BUTTON_RIGHT and event.pressed:
			#print(\"click!!\")
			
			if numSpells < MAX_SPELLS:
				var spell_instance = spell_path_01.instantiate()
				print(spell_instance)
				spell_instance.global_position = $CursorTracker.global_position
				print(spell_instance.global_position)
				
				print(numSpells)
				
				
				spell01Fire(spell_instance)
				numSpells = numSpells + 1;	
				spell_instance.playSound()
		elif event.button_index == MouseButton.MOUSE_BUTTON_LEFT and event.pressed:
			print(get_global_mouse_position())
			var spell_instance = spell_path_02.instantiate()
			print(spell_instance)
			spell_instance.global_position = $CursorTracker.global_position
			print(spell_instance.global_position)
			pew(spell_instance)
			print(numSpells)
		
			
func pew(instance):
	add_child(instance)
	instance.setOGPos(player)
	instance.setRotation(player.getDirection(), calc_pew_dir())
	await get_tree().create_timer(5).timeout
	remove_child(instance)
	
func calc_pew_dir() -> Vector2:
	var mouse_pos = get_global_mouse_position()
	
	var grad_x = (mouse_pos.x - player.global_position.x) 
	var grad_y = mouse_pos.y - player.global_position.y
	
	var move_dir = Vector2(grad_x, grad_y)
	
	return move_dir.normalized()
			
func spell01Fire(instance):
	
	add_child(instance)
	
	await get_tree().create_timer(5).timeout
	instance.playDeath()
	
	remove_child(instance)
	numSpells -= 1;
			


func _on_music_switch_creepy_body_entered(body: Node2D) -> void:
	if body.is_in_group(\"player\"):
		$AudioStreamPlayer2D.stream = load(\"res://Music/shiver me timbers.mp3\")
		$AudioStreamPlayer2D.play()

func _on_music_switch_boss_body_entered(body: Node2D) -> void:
	if body.is_in_group(\"player\"):
		$AudioStreamPlayer2D.stream = load(\"res://Music/BossMusic.mp3\")
		$AudioStreamPlayer2D.play()
func _on_death_screen_body_entered(body: Node2D) -> void:
	if body.is_in_group(\"player\"):
		$AudioStreamPlayer2D.stream = load(\"res://Music/DeathScreen.mp3\") # Replace with function body.
		$AudioStreamPlayer2D.play()

func _on_music_switch_combat_body_entered(body: Node2D) -> void:
	if body.is_in_group(\"player\"):
		$AudioStreamPlayer2D.stream = load(path) # Replace with function body.
		$AudioStreamPlayer2D.play()


func _on_music_slower_body_entered(body: Node2D) -> void:
	if body.is_in_group(\"player\"):
		$MusicSwitches/MusicAnimator.play(\"SlowDown\")


func _on_music_slower_body_exited(body: Node2D) -> void:
	if body.is_in_group(\"player\"):
		$MusicSwitches/MusicAnimator.play(\"SpeedUp\")


func _on_pause_body_entered(body: Node2D) -> void:
	if body.is_in_group(\"player\"):
		$AudioStreamPlayer2D.stop()
"

